# ---------------------------------------------------------------------------
# Copy to `.env` (`make setup` does this for you) and edit if ports clash.
# Every Python entry point reads ONLY from these variables via config.py.
# ---------------------------------------------------------------------------

# --- OLTP (3NF source system) ----------------------------------------------
OLTP_DB_USER=airline
OLTP_DB_PASSWORD=airline
OLTP_DB_NAME=airline_oltp
OLTP_DB_HOST=localhost
OLTP_DB_PORT=5432
OLTP_DB_URL=postgresql+psycopg2://airline:airline@localhost:5432/airline_oltp

# --- Data Warehouse (star schema target) -----------------------------------
DW_DB_USER=airline
DW_DB_PASSWORD=airline
DW_DB_NAME=airline_dw
DW_DB_HOST=localhost
DW_DB_PORT=5433
DW_DB_URL=postgresql+psycopg2://airline:airline@localhost:5433/airline_dw

# --- Adminer ----------------------------------------------------------------
ADMINER_PORT=8080

# --- ELT behaviour ----------------------------------------------------------
# Fallback service date used when a staging timestamp carries no date part.
SERVICE_DATE=2026-09-09
# Allowed drift (minutes) between the raw `duration` string and the duration
# recomputed from departure/arrival. 0 = raw input must be exactly right.
DURATION_TOLERANCE_MINUTES=0
# Where `make transform` writes its inspectable artifacts.
DATA_DIR=data
LOG_LEVEL=INFO
